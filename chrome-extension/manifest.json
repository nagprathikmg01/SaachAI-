{
  "manifest_version": 3,
  "name": "SachhAI Interview Checker",
  "version": "2.4",
  "description": "Detect AI-generated and plagiarised interview responses using style comparison and plagiarism scanning.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "SachhAI",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "microphone",
    "tabCapture"
  ],
  "host_permissions": [
    "https://naagazz-interview-checker.hf.space/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*",
    "https://meet.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://naagazz-interview-checker.hf.space/*",
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["meet_cc_guard.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
