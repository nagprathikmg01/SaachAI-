# ── Python / OS / Node Ignores ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
venv/
.venv/
env/
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.cursor/
node_modules/
*.log

# ── Selective QA / Testing Repository Whitelist ──────────────────────────────
# Ignore everything in the root by default
/*

# Exclude these root files/directories from being ignored
!tests/
!backend/
!frontend/
!README.md
!.gitignore
!SachhAI_*.pdf

# Inside backend/, ignore everything except the specific test files and sub-folders
/backend/*
!/backend/accuracy_test.py
!/backend/test_comparator.py
!/backend/test_api.py
!/backend/test_detection.py
!/backend/test_dg.py
!/backend/voice_module/

# Inside backend/voice_module/, ignore everything except the style comparator test
/backend/voice_module/*
!/backend/voice_module/test_style_comparator.py

# Inside frontend/, ignore everything except the QA dashboard and reports
/frontend/*
!/frontend/qa_hub.html
!/frontend/SachhAI_Detailed_Testing_Report.pdf
!/frontend/SachhAI_Final_Launch_Sign_Off_Report.pdf
!/frontend/SachhAI_SaaS_Production_Readiness_Report.pdf
!/frontend/SachhAI_Security_Hardening_Report.pdf
!/frontend/SachhAI_Test_Report.pdf