# ─────────────────────────────────────────────────────────────────────────────
# SacchAI — Interview Integrity Co-Pilot | Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
#
# Copy this file to backend/.env and fill in your own keys:
#   cp .env.example backend/.env
#
# For Hugging Face Spaces: add each key as a Secret in Settings → Repository secrets
# For Docker: pass via --env-file or docker-compose environment section
#
# ⚠️  NEVER commit backend/.env — it is gitignored for your safety.
# ─────────────────────────────────────────────────────────────────────────────

# ── Transcription (required) ────────────────────────────────────────────────
# Sign up at https://console.deepgram.com/ — free tier includes 200 minutes/month
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── Plagiarism & AI Detection (optional) ────────────────────────────────────
# Sign up at https://gowinston.ai/ — the system works without this (uses built-in detection)
WINSTON_AI_API_KEY=your_winston_ai_api_key_here

# ── OpenAI (optional — not actively used in core analysis) ──────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Database (required for persistence) ─────────────────────────────────────
# Create a free project at https://supabase.com/
# You need a table called `voice_data` with columns:
#   candidate_id (text, primary key), personal (text), technical (text),
#   analysis (jsonb), submitted_by (text), created_at (timestamptz)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ── Authentication ──────────────────────────────────────────────────────────
# Generate a strong random string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRE_HOURS=24

# ── Notifications (optional) ────────────────────────────────────────────────
# Slack webhook for suspicious verdict alerts
# Get one at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ── Default Admin Account ───────────────────────────────────────────────────
# Used to seed the initial admin user on first run.
# ⚠️  Change these immediately after first login in production!
ADMIN_EMAIL=admin@system.local
ADMIN_PASSWORD=change_me_on_first_login
